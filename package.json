{
  "name": "zuma-pwa",
  "version": "2.0.19",
  "private": true,
  "type": "module",
  "description": "Zuma R2.0.19 — fidelity reconstruction, PWA shell and regression-locked test bench",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test \"tests/*.test.mjs\" && node tools/guard.mjs",
    "dev": "node tools/build.mjs --local && node tools/serve.mjs",
    "check": "tsc --noEmit",
    "standalone": "node tools/build.mjs --standalone",
    "guard": "node tools/guard.mjs",
    "import": "node tools/import-original.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "files": [
    "src",
    "public",
    "index.html",
    "tools",
    "tests"
  ]
}
